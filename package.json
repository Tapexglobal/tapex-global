{
  "name": "tapex-global",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "lint": "prettier --check src public/*.js public/*.css api lib scripts tests package.json vercel.json .github/workflows/*.yml && node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm run lint && npm test",
    "test:browser": "node scripts/browser-suite.mjs",
    "lighthouse": "node scripts/lighthouse-check.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "lighthouse": "^13.5.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
